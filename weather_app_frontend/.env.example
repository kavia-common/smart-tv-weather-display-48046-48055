# Frontend runtime configuration (Vite)
VITE_API_BASE=
# Option A: Leave VITE_API_BASE empty and use direct OpenWeather calls with API key below.
# Option B: Point VITE_API_BASE to your backend proxy that injects credentials.

# Required if calling OpenWeather directly from frontend (avoid in production; prefer proxy).
VITE_WEATHER_API_KEY=

# Optional logging level: 'silent' to suppress retry warnings
VITE_LOG_LEVEL=info
