# Frontend environment variables for weather_app_frontend

# Dev server port (Vite). If 3000 is occupied in the environment, change this value.
VITE_PORT=3000

# Optional URLs (not currently required by the stubbed frontend)
VITE_API_BASE=https://api.example.com
VITE_BACKEND_URL=https://backend.example.com
VITE_FRONTEND_URL=https://frontend.example.com
VITE_WS_URL=wss://backend.example.com/ws
VITE_NODE_ENV=development
VITE_NEXT_TELEMETRY_DISABLED=1
VITE_ENABLE_SOURCE_MAPS=1
VITE_TRUST_PROXY=1
VITE_LOG_LEVEL=info
VITE_HEALTHCHECK_PATH=/healthz
VITE_FEATURE_FLAGS={}
VITE_EXPERIMENTS_ENABLED=0
